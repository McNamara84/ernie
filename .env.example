APP_NAME=ERNIE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://ernie.rz-vm182.gfz.de

# Public pages: true serves ERNIE; false returns a local HTTP 404.
# All environments default to true; explicit false overrides disable a page.
PUBLIC_HOME_ENABLED=true
PUBLIC_FIND_ENABLED=true
PUBLIC_DATA_CENTRES_ENABLED=true
PUBLIC_DATA_CENTRE_DESCRIPTION_ENABLED=true

ERNIE_API_KEY=1234-1234-1234-1234 # ggignore

# ELMO cache refresh (outgoing admin requests; separate from ERNIE_API_KEY).
# Local development refreshes Stage ELMO; Production URLs are set in its Compose file.
ELMO_CACHE_REFRESH_ENABLED=false
# Enable only after ELMO-MSL uses its own ERNIE source routes.
ELMO_MSL_CACHE_REFRESH_READY=false
ELMO_BASE_URL=https://env.rz-vm182.gfz.de/elmo
ELMO_API_KEY=
ELMO_MSL_BASE_URL=https://env.rz-vm182.gfz.de/elmo-msl
ELMO_MSL_API_KEY=
ELMO_CACHE_REFRESH_CONNECT_TIMEOUT=10
ELMO_CACHE_REFRESH_TIMEOUT=310
ELMO_CACHE_REFRESH_JOB_TIMEOUT=330
ELMO_CACHE_REFRESH_RETRY_AFTER=390

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=31

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel_user
DB_PASSWORD=secret

# Stage/production container tuning. Leave unset to use the Compose defaults
# documented in docs/production-runtime-performance.md.
# PHP_FPM_MAX_CHILDREN=6
# PHP_FPM_START_SERVERS=2
# PHP_FPM_MIN_SPARE_SERVERS=2
# PHP_FPM_MAX_SPARE_SERVERS=4
# PHP_FPM_MAX_REQUESTS=500
# MYSQL_INNODB_BUFFER_POOL_SIZE=3G
# MYSQL_MAX_CONNECTIONS=60

# Host VM resource monitoring. Production and Stage Compose enable this and
# mount only /proc/stat and /proc/meminfo read-only into the scheduler.
SYSTEM_METRICS_ENABLED=false
SYSTEM_METRICS_PROC_STAT_PATH=/host/proc/stat
SYSTEM_METRICS_PROC_MEMINFO_PATH=/host/proc/meminfo
SYSTEM_METRICS_RETENTION_DAYS=30

# Anonymous hourly public-traffic aggregates. Stage and production enable the
# collector in Compose; local self-probing stays disabled by default.
PUBLIC_TRAFFIC_ENABLED=false
PUBLIC_TRAFFIC_HEALTH_URL=
PUBLIC_TRAFFIC_HEALTH_CONNECT_TIMEOUT_SECONDS=2
PUBLIC_TRAFFIC_HEALTH_TIMEOUT_SECONDS=4
PUBLIC_TRAFFIC_RETENTION_DAYS=400
PUBLIC_TRAFFIC_DEDUPLICATION_GRACE_SECONDS=300
# Optional comma-separated additions to the built-in recognizable crawler list.
BOT_PROTECTION_ADDITIONAL_CRAWLER_USER_AGENTS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=7260
ASSISTANCE_QUEUE=assistance
ASSISTANCE_JOB_TIMEOUT=3600
ASSISTANCE_QUEUE_RETRY_AFTER=3660
ASSISTANCE_WORKER_CPUS=0.5

# Cache driver (Options: file, database, redis, memcached, array)
# Use 'redis' for optimal performance with cache tagging support
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Data publication team: contact-form Cc and direct fallback for all-recipient data requests
# Empty or invalid disables team delivery and team-only data request actions
# Must be valid and non-empty for review-link delivery; otherwise the endpoint returns HTTP 503
LANDING_PAGE_CONTACT_CC_EMAIL=datapub@gfz.de

# Initial download URL suggestion; an empty value disables the installation default.
# A saved order in Editor Settings (including []) always takes precedence.
LANDING_PAGE_DEFAULT_DOWNLOAD_URL_PREFIX=https://datapub.gfz.de/download

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional tolerance for detecting whole-world geographic boxes.
# Keep the backend and Vite values in sync when overriding the default.
GEO_GLOBAL_COVERAGE_TOLERANCE=
VITE_GEO_GLOBAL_COVERAGE_TOLERANCE="${GEO_GLOBAL_COVERAGE_TOLERANCE}"

# Persistent FAIR assessment runs. The queue connection must use a persistent
# driver and every worker must share the same cache-backed request limiter.
FUJI_ENABLED=false
FUJI_BASE_URL=http://fuji:1071
FUJI_USERNAME=ernie
FUJI_PASSWORD=change-me
FUJI_TIMEOUT=300
FUJI_CONNECT_TIMEOUT=10
FUJI_USE_DATACITE=true
FUJI_USE_GITHUB=false
FUJI_METRIC_VERSION=metrics_v0.8
FUJI_ASSESSMENT_QUEUE_CONNECTION=assessment
FUJI_ASSESSMENT_QUEUE=assessments
FUJI_ASSESSMENT_CONCURRENCY=1
FUJI_ASSESSMENT_REQUESTS_PER_MINUTE=80
FUJI_ASSESSMENT_WINDOW_SECONDS=60
FUJI_ASSESSMENT_MINIMUM_INTERVAL_MS=750
FUJI_ASSESSMENT_ITEM_TIMEOUT=330
FUJI_ASSESSMENT_LEASE_SECONDS=390
FUJI_ASSESSMENT_MAX_ATTEMPTS=3
FUJI_ASSESSMENT_RETRY_BASE_SECONDS=15
FUJI_ASSESSMENT_RETRY_JITTER_SECONDS=5
FUJI_ASSESSMENT_QUEUE_RETRY_AFTER=390

# Google Maps API Key for geocoding and map display
GM_API_KEY=

# ORCID API Configuration
# The ORCID Public API does not require authentication for read-only access
# See: https://info.orcid.org/documentation/api-tutorials/api-tutorial-read-data-on-a-record/
ORCID_API_URL=https://pub.orcid.org/v3.0
ORCID_SEARCH_URL=https://pub.orcid.org/v3.0/search

# DataCite API Credentials for DOI management
# USERNAME should be your Repository ID (e.g., "gfz.ernie" or "datacite.datacite")
# PASSWORD is your repository password from DataCite Fabrica
# Test credentials are completely separate from production credentials.
# Use test mode and separate test repository credentials for development.
# Get test account at: https://doi.test.datacite.org/
DATACITE_TEST_MODE=true
CURATION_WAITING_OVERDUE_DAYS=14
DATACITE_TEST_USERNAME=
DATACITE_TEST_PASSWORD=
DATACITE_TEST_CLIENT_ID=
DATACITE_TEST_ENDPOINT=https://api.test.datacite.org
DATACITE_USERNAME=
DATACITE_PASSWORD=
DATACITE_CLIENT_ID=tib.gfz
DATACITE_ENDPOINT=https://api.datacite.org
DATACITE_SCHEMA_UPGRADE_PAGE_SIZE=1000
# Prefix 10.60510 belongs to the separate GFZ.IGSN DataCite repository.
DATACITE_IGSN_PREFIX=10.60510
DATACITE_IGSN_CLIENT_ID=gfz.igsn
DATACITE_IGSN_USERNAME=
DATACITE_IGSN_PASSWORD=
DATACITE_TRANSPORT_TRANSIENT_ATTEMPTS=3
DATACITE_INTERACTIVE_RESERVED_REQUESTS=30
DATACITE_INTERACTIVE_MAX_WAIT_MS=5000
# Persistent queue shared by all long-running DataCite write workflows.
DATACITE_QUEUE=datacite
# Safe defaults for landing-page URL migration after APP_URL changes.
DATACITE_URL_UPDATE_REQUESTS_PER_WINDOW=300
DATACITE_URL_UPDATE_WINDOW_SECONDS=300
DATACITE_URL_UPDATE_MINIMUM_INTERVAL_MS=1000
DATACITE_URL_UPDATE_CONNECT_TIMEOUT_SECONDS=10
DATACITE_URL_UPDATE_TIMEOUT_SECONDS=30
DATACITE_URL_UPDATE_REACHABILITY_CONNECT_TIMEOUT_SECONDS=3
DATACITE_URL_UPDATE_REACHABILITY_TIMEOUT_SECONDS=8
DATACITE_URL_UPDATE_MAX_TRANSIENT_ATTEMPTS=5
DATACITE_USER_AGENT_EMAIL=datapub@gfz.de
DATACITE_CITATION_EXHAUSTIVE_CONCURRENCY=4
DATACITE_CITATION_EXHAUSTIVE_TIMEOUT_SECONDS=10
DATACITE_CITATION_EXHAUSTIVE_ATTEMPTS=3
DATACITE_CITATION_EXHAUSTIVE_RETRY_DELAY_MS=500

# ISO 19115-3:2023 metadata representation and metadata-record contact
ISO19115_ENABLED=true
ISO19115_METADATA_CONTACT_NAME="GFZ Data Services"
ISO19115_METADATA_CONTACT_EMAIL=datapub@gfz.de
ISO19115_METADATA_CONTACT_WEBSITE=https://dataservices.gfz.de/

# Public portal map: bounded viewport responses and server-side clustering
PORTAL_MAP_ENABLED=true
PORTAL_MAP_MAX_ZOOM=18
PORTAL_MAP_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
PORTAL_MAP_MAX_FEATURES=1000
PORTAL_MAP_CLUSTER_RADIUS=60
PORTAL_MAP_SHAPE_DETAIL_ZOOM=10
PORTAL_MAP_CLUSTER_MEMBERS_PER_PAGE=50
PORTAL_IGSN_MAP_MATERIAL_VISUALIZATION_ENABLED=true
PORTAL_MAP_CACHE_TTL=30
PORTAL_MAP_EXTENT_CACHE_TTL=300
BOT_PROTECTION_PUBLIC_PORTAL_MAP_PER_MINUTE=120
BOT_PROTECTION_PUBLIC_PORTAL_SUGGESTIONS_PER_MINUTE=60
BOT_PROTECTION_PORTAL_CACHE_TTL=120
BOT_PROTECTION_PORTAL_CACHE_FRESH_TTL=60
BOT_PROTECTION_PORTAL_CACHE_LOCK_SECONDS=15
BOT_PROTECTION_PORTAL_CACHE_LOCK_WAIT_SECONDS=10

# Persistent disk serving sample images stored during the completed migration.
IGSN_IMAGE_DISK=public

# Legacy IGSN database exports still require this bundled MySQL-compatible client. Override the path only for
# non-Docker deployments that install the client elsewhere.
DATABASE_DUMP_IGSN_BINARY=/usr/local/bin/mysql-legacy-mysqldump

# MSL Laboratories vocabulary source
# The updater discovers the highest stable version below MSL_LABORATORIES_BASE_PATH.
# Runtime clients use the validated local copy; deployments need outbound access
# to the configured GitHub API and the download URL returned by that API.
MSL_GITHUB_API_BASE=https://api.github.com
MSL_GITHUB_REPOSITORY=UtrechtUniversity/msl_vocabularies
MSL_GITHUB_REF=main
MSL_LABORATORIES_BASE_PATH=vocabularies/labs
MSL_LABORATORIES_FILENAME=laboratories.json
MSL_HTTP_TIMEOUT=30
MSL_HTTP_RETRIES=3
MSL_HTTP_RETRY_DELAY_MS=200

# Crossref API Configuration (Citation Manager)
# Used by the Citation Manager to look up bibliographic metadata by DOI.
# Crossref asks all API users to identify themselves via a mailto address
# to get polite-pool access. Use an address you control and monitor.
# See: https://api.crossref.org/swagger-ui/index.html
# Enable the manually reviewed Crossref Grants / CORDIS award URI assistant.
FUNDING_AWARD_URI_ENABLED=false

CROSSREF_MAILTO=your-email@example.org
CROSSREF_BASE_URL=https://api.crossref.org/works
CROSSREF_TIMEOUT=8
CROSSREF_CACHE_TTL=86400

# Dedicated random secret (at least 32 characters); never reuse APP_KEY.
# Tracking remains inactive until `php artisan counter:activate`.
COUNTER_SESSION_SECRET=
