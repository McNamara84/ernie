# Public, non-secret Portainer variable template.
# Configure credentials in Portainer; never commit live values here.

# Application
APP_KEY=
APP_ENV=production
APP_URL=https://ernie.rz-vm182.gfz.de
APP_PORT=8084
LARAVEL_PORT_NUMBER=80

# Database connection for Laravel
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ernie
DB_USERNAME=ernie
DB_PASSWORD=

ERNIE_API_KEY=

# Host VM CPU/RAM history displayed on the admin Logs page.
SYSTEM_METRICS_ENABLED=true
SYSTEM_METRICS_RETENTION_DAYS=30

# Redis configuration
REDIS_HOST=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_DRIVER=redis

# MariaDB service configuration
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=ernie
MARIADB_USER=ernie
MARIADB_PASSWORD=

# Solr server credentials
SOLR_HOST=doidb.wdc-terra.org
