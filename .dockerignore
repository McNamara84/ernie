# Dependencies (will be installed in container)
/node_modules
/vendor

# Version Control
/.git
/.github

# IDE & Editor files
/.idea
/.vscode

# Cache files
/bootstrap/cache/*.php
/.tmp
/.trivy-cache
/trivy-results
/ernie-*-security-scan.tar

# Local runtime data must not be baked into application or Nginx images.
/storage/logs/*
!/storage/logs/.gitignore
/storage/inertia-devtools
/storage/framework/cache/**
!/storage/framework/cache/**/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/app/**
!/storage/app/**/.gitignore
!/storage/app/testing/**

# Environment files (production will be copied explicitly)
.env
.env.*
!.env.production
!.env.example
!.env.docker.example
!.env.testing
.env.backup
# Key-generation leftovers can contain credentials after an abrupt container stop.
.env-key.*
.env.local
/stack.env

# Testing (this is the main optimization - no tests in production)
/tests
/coverage
/playwright-report
/test-results
/storage/framework/testing
/storage/framework/.config
/.release-candidate

# Build artifacts
/public/hot
/public/build
/public/storage

# Development files
docker-compose.yml
Dockerfile
