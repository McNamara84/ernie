# Dependencies (will be installed in container)
/node_modules
/vendor

# Version Control
/.git
/.github

# IDE & Editor files
/.idea
/.vscode

# Cache files
/bootstrap/cache/*.php
/.tmp

# Environment files (production will be copied explicitly)
.env
.env.backup
# Key-generation leftovers can contain credentials after an abrupt container stop.
.env-key.*
.env.local
/stack.env

# Testing (this is the main optimization - no tests in production)
/tests
/coverage
/playwright-report
/test-results
/storage/framework/testing
/storage/framework/.config
/.release-candidate

# Build artifacts
/public/hot
/public/build
/public/storage

# Development files
docker-compose.yml
Dockerfile
