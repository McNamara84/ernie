* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

CHANGELOG.md export-ignore
README.md export-ignore

# Keep the official DataCite schema snapshot byte-for-byte.
resources/data/scheme/datacite-4.7/** -whitespace

# Keep the official COUNTER classification snapshot byte-for-byte.
resources/data/counter/counter-robots.json -whitespace

# Keep the official ISO/TR 19115-4 schema snapshot byte-for-byte.
resources/data/scheme/iso-19115-4/** -whitespace

# Preserve the pinned IGSN Core upstream blobs, including their original line endings.
resources/data/scheme/igsn-core/**/upstream/** -text -whitespace

# Preserve published portable revisions and their checksum manifests byte-for-byte.
resources/data/scheme/igsn-core/2.0/preview-*/** -text -whitespace
